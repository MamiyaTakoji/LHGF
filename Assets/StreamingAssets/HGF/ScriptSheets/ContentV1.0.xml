<?xml version="1.0" encoding="utf-8"?>
<data>
	<title>引导章节</title>
	<Synopsis>这个章节用于选择观看演示故事还是观看使用教程</Synopsis>
	<BranchPlot>
		<BranchPlotNode ID="S1">
			<Speak CharacterID="1" Content="再次点击将跳转演示故事。" Id="S1-0" TextType="TexDraw"/>
			<NextScript NextScriptName="ExampleStoryV1.0"/>
		</BranchPlotNode>
		<BranchPlotNode ID="S2">
			<Speak CharacterID="1" Content="再次点击将跳转使用介绍。" Id="S2-0" TextType="TexDraw"/>
			<NextScript NextScriptName="UsingGuideV1.0"/>
		</BranchPlotNode>
	</BranchPlot>
	<MainPlot>
		<AddCharacter CharacterID="1" From="me" SendMessage="ToShow"/>
		<Speak CharacterID="1" Content="请问你要看哪个？" Id="0" TextType="TexDraw">
			<Choice JumpID="S1" TextType="TexDraw">观看演示故事</Choice>
			<Choice JumpID="S2" TextType="TexDraw">观看使用说明</Choice>
		</Speak>
		<Speak Content="1111" Id="1" TextType="TexDraw"/>
	</MainPlot>
</data>
