        },
        {
          "Content": "ayakayaka$\\text{的}$$\\text{身}$$\\text{体}$$\\text{从}$$\\text{喉}$$\\text{咙}$$\\text{到}$$\\text{下}$$\\text{腹}$$\\text{部}$$\\text{往}$$\\text{前}$$\\text{突}$$\\text{出}$$\\text{。}$$\\text{在}$$\\text{那}$$\\text{同}$$\\text{时}$$\\text{，}$$\\text{她}$$\\text{的}$$\\text{背}$$\\text{脊}$$\\text{圆}$$\\text{圆}$$\\text{弓}$$\\text{起}$$\\text{，}$$\\text{颈}$$\\text{部}$$\\text{被}$$\\text{压}$$\\text{挤}$$\\text{消}$$\\text{失}$$\\text{。}$ayakayaka$\\text{整}$$\\text{个}$$\\text{人}$$\\text{像}$$\\text{气}$$\\text{球}$$\\text{一}$$\\text{样}$$\\text{圆}$$\\text{圆}$$\\text{鼓}$$\\text{起}$$\\text{，}$$\\text{跟}$$\\text{着}$$\\text{一}$$\\text{脸}$$\\text{呆}$$\\text{愣}$$\\text{的}$$\\text{表}$$\\text{情}$$\\text{看}$$\\text{向}$$\\text{文}$$\\text{哉}$$\\text{。}$",
          "TextType": "TexDraw",
          "Skip": false,
