            "grayscale": 0.0,
            "maxColorComponent": 0.0
          }
        },
        {
          "Content": "$\\text{尽}$$\\text{管}$$\\text{知}$$\\text{道}$$\\text{自}$$\\text{己}$$\\text{完}$$\\text{全}$$\\text{失}$$\\text{了}$$\\text{焦}$$\\text{，}$$\\text{文}$$\\text{哉}$$\\text{还}$$\\text{是}$$\\text{忍}$$\\text{不}$$\\text{住}$$\\text{惊}$$\\text{叹}$$\\text{地}$$\\text{心}$$\\text{想}$$\\text{：}$$\\text{「}$ayakayaka$\\text{那}$$\\text{小}$$\\text{小}$$\\text{的}$$\\text{身}$$\\text{躯}$$\\text{竟}$$\\text{然}$$\\text{装}$$\\text{得}$$\\text{下}$$\\text{这}$$\\text{么}$$\\text{多}$$\\text{东}$$\\text{西}$$\\text{！}$$\\text{」}$",
