            "maxColorComponent": 0.0
          }
        },
        {
          "Content": "$\\text{最}$$\\text{初}$$\\text{，}$$\\text{文}$$\\text{哉}$$\\text{以}$$\\text{为}$ayakayaka$\\text{做}$$\\text{出}$$\\text{往}$$\\text{后}$$\\text{仰}$$\\text{的}$$\\text{动}$$\\text{作}$$\\text{。}$",
          "TextType": "TexDraw",
