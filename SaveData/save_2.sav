            "grayscale": 0.0,
            "maxColorComponent": 0.0
          }
        },
        {
          "Content": "$\\text{象}$$\\text{山}$$\\text{点}$$\\text{头}$$\\text{致}$$\\text{谢}$$\\text{后}$$\\text{，}$$\\text{走}$$\\text{离}$$\\text{桌}$$\\text{旁}$$\\text{。}$",
          "TextType": "TexDraw",
          "Skip": false,
