            "g": 0.0,
            "b": 0.0,
            "a": 0.8313726,
            "grayscale": 0.0,
            "maxColorComponent": 0.0
          }
        },
        {
          "Content": "$\\text{『}$$\\text{有}$$\\text{人}$$\\text{躲}$$\\text{在}$$\\text{里}$$\\text{岛}$$\\text{先}$$\\text{生}$$\\text{的}$$\\text{房}$$\\text{间}$$\\text{里}$$\\text{？}$$\\text{你}$$\\text{是}$$\\text{怎}$$\\text{么}$$\\text{知}$$\\text{道}$$\\text{的}$$\\text{？}$$\\text{』}$",
          "TextType": "TexDraw",
          "Skip": false,
          "SpeakerName": "芋洼",
          "DepartmentName": "",
          "DialogBarColor": {
            "r": 0.0,
            "g": 0.0,
            "b": 0.0,
            "a": 0.8313726,
            "grayscale": 0.0,
            "maxColorComponent": 0.0
          }
        },
        {
          "Content": "$\\text{接}$$\\text{下}$$\\text{来}$$\\text{将}$$\\text{进}$$\\text{入}$$\\text{这}$$\\text{个}$$\\text{游}$$\\text{戏}$$\\text{的}$$\\text{推}$$\\text{理}$$\\text{环}$$\\text{节}$$\\text{，}$$\\text{只}$$\\text{有}$$\\text{出}$$\\text{示}$$\\text{了}$$\\text{正}$$\\text{确}$$\\text{的}$$\\text{证}$$\\text{据}$$\\text{才}$$\\text{能}$$\\text{推}$$\\text{进}$$\\text{剧}$$\\text{情}$$\\text{。}$",
          "TextType": "TexDraw",
          "Skip": false,
          "SpeakerName": " ",
          "DepartmentName": "",
          "DialogBarColor": {
            "r": 0.0,
            "g": 0.0,
            "b": 0.0,
            "a": 0.8313726,
            "grayscale": 0.0,
            "maxColorComponent": 0.0
          }
        },
        {
          "Content": "$\\text{当}$$\\text{然}$$\\text{，}$$\\text{如}$$\\text{果}$$\\text{实}$$\\text{在}$$\\text{没}$$\\text{有}$$\\text{头}$$\\text{绪}$$\\text{，}$$\\text{也}$$\\text{可}$$\\text{以}$$\\text{选}$$\\text{择}$$\\text{按}$$\\text{跳}$$\\text{过}$$\\text{按}$$\\text{钮}$$\\text{直}$$\\text{接}$$\\text{选}$$\\text{择}$$\\text{正}$$\\text{确}$$\\text{证}$$\\text{据}$$\\text{，}$$\\text{不}$$\\text{需}$$\\text{要}$$\\text{穷}$$\\text{举}$$\\text{。}$",
          "TextType": "TexDraw",
          "Skip": false,
          "SpeakerName": "",
          "DepartmentName": "",
          "DialogBarColor": {
            "r": 0.0,
            "g": 0.0,
            "b": 0.0,
            "a": 0.8313726,
            "grayscale": 0.0,
            "maxColorComponent": 0.0
          }
        },
        {
          "Content": "$\\text{「}$$\\text{我}$$\\text{恰}$$\\text{巧}$$\\text{听}$$\\text{见}$$\\text{病}$$\\text{患}$$\\text{们}$$\\text{聊}$$\\text{起}$$\\text{早}$$\\text{上}$$\\text{发}$$\\text{生}$$\\text{过}$$\\text{地}$$\\text{震}$$\\text{。}$$\\text{」}$",
          "TextType": "TexDraw",
          "Skip": false,
          "SpeakerName": "象山",
