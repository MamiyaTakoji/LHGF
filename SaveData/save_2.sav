            "maxColorComponent": 0.0
          }
        },
        {
          "Content": "$\\text{「}$$\\text{不}$$\\text{过}$$\\text{，}$$\\text{真}$$\\text{没}$$\\text{想}$$\\text{到}$$\\text{会}$$\\text{在}$$\\text{这}$$\\text{种}$$\\text{地}$$\\text{方}$$\\text{遇}$$\\text{见}$Pulpara$\\text{的}$$\\text{玩}$$\\text{家}$$\\text{。}$$\\text{」}$",
