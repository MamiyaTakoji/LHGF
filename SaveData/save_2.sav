            "maxColorComponent": 0.0
          }
        },
        {
          "Content": "$\\text{文}$$\\text{哉}$$\\text{察}$$\\text{觉}$$\\text{到}$$\\text{女}$$\\text{孩}$$\\text{的}$$\\text{目}$$\\text{光}$$\\text{停}$$\\text{留}$$\\text{在}$$\\text{自}$$\\text{己}$$\\text{的}$$\\text{右}$$\\text{手}$$\\text{片}$$\\text{刻}$$\\text{。}$$\\text{直}$$\\text{到}$$\\text{三}$$\\text{个}$$\\text{月}$$\\text{前}$$\\text{，}$$\\text{文}$$\\text{哉}$$\\text{还}$$\\text{是}$$\\text{山}$$\\text{岳}$$\\text{社}$$\\text{的}$$\\text{社}$$\\text{员}$$\\text{，}$$\\text{手}$$\\text{上}$$\\text{有}$$\\text{着}$$\\text{大}$$\\text{大}$$\\text{一}$$\\text{道}$$\\text{被}$$\\text{野}$$\\text{营}$$\\text{刀}$$\\text{刺}$$\\text{伤}$$\\text{的}$$\\text{伤}$$\\text{痕}$$\\text{。}$",
