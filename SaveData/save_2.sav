            "a": 0.8313726,
            "grayscale": 0.0,
            "maxColorComponent": 0.0
          }
        },
        {
          "Content": "$\\text{「}$$\\text{那}$$\\text{我}$$\\text{自}$$\\text{己}$$\\text{动}$$\\text{手}$$\\text{，}$$\\text{请}$$\\text{芋}$$\\text{洼}$$\\text{先}$$\\text{生}$$\\text{在}$$\\text{旁}$$\\text{边}$$\\text{陪}$$\\text{同}$$\\text{。}$$\\text{」}$",
          "TextType": "TexDraw",
