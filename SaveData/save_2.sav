            "maxColorComponent": 0.0
          }
        },
        {
          "Content": "$\\text{文}$$\\text{哉}$$\\text{把}$$\\text{豆}$$\\text{皮}$$\\text{乌}$$\\text{龙}$$\\text{面}$$\\text{端}$$\\text{给}$$\\text{板}$$\\text{着}$$\\text{脸}$$\\text{的}$$\\text{医}$$\\text{师}$$\\text{、}$$\\text{把}$$\\text{豆}$$\\text{腐}$$\\text{汉}$$\\text{堡}$$\\text{排}$$\\text{定}$$\\text{食}$$\\text{端}$$\\text{给}$$\\text{古}$$\\text{柯}$$\\text{碱}$$\\text{成}$$\\text{瘾}$$\\text{的}$$\\text{女}$$\\text{子}$$\\text{后}$$\\text{，}$$\\text{立}$$\\text{刻}$$\\text{回}$$\\text{到}$ayakayaka$\\text{身}$$\\text{边}$$\\text{。}$",
