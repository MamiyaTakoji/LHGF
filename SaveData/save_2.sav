            "grayscale": 0.0,
            "maxColorComponent": 0.0
          }
        },
        {
          "Content": "$\\text{果}$$\\text{然}$$\\text{是}$$\\text{真}$$\\text{的}$$\\text{。}$",
          "TextType": "TexDraw",
          "Skip": false,
          "SpeakerName": " ",
          "DepartmentName": "",
          "DialogBarColor": {
            "r": 0.0,
