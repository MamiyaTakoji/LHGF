            "maxColorComponent": 0.0
          }
        },
        {
          "Content": "$\\text{突}$$\\text{然}$$\\text{被}$$\\text{搭}$$\\text{讪}$$\\text{后}$$\\text{，}$$\\text{女}$$\\text{孩}$$\\text{停}$$\\text{下}$$\\text{原}$$\\text{本}$$\\text{正}$$\\text{准}$$\\text{备}$$\\text{把}$$\\text{炖}$$\\text{牛}$$\\text{肉}$$\\text{送}$$\\text{进}$$\\text{嘴}$$\\text{里}$$\\text{的}$$\\text{动}$$\\text{作}$$\\text{，}$$\\text{露}$$\\text{出}$$\\text{夹}$$\\text{杂}$$\\text{着}$$\\text{畏}$$\\text{惧}$$\\text{以}$$\\text{及}$$\\text{困}$$\\text{惑}$$\\text{情}$$\\text{绪}$$\\text{的}$$\\text{眼}$$\\text{神}$$\\text{看}$$\\text{向}$$\\text{文}$$\\text{哉}$$\\text{。}$",
          "TextType": "TexDraw",
          "Skip": false,
          "SpeakerName": " ",
          "DepartmentName": "",
          "DialogBarColor": {
