            "a": 0.8313726,
            "grayscale": 0.0,
            "maxColorComponent": 0.0
          }
        },
        {
          "Content": "$\\text{象}$$\\text{山}$$\\text{发}$$\\text{现}$$\\text{自}$$\\text{己}$$\\text{严}$$\\text{重}$$\\text{认}$$\\text{知}$$\\text{错}$$\\text{误}$$\\text{。}$$\\text{这}$$\\text{么}$$\\text{一}$$\\text{来}$$\\text{，}$$\\text{就}$$\\text{表}$$\\text{示}$$\\text{再}$$\\text{这}$$\\text{样}$$\\text{下}$$\\text{去}$$\\text{不}$$\\text{妙}$$\\text{。}$",
          "TextType": "TexDraw",
          "Skip": false,
          "SpeakerName": " ",
