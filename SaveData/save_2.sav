            "maxColorComponent": 0.0
          }
        },
        {
          "Content": "$\\text{象}$$\\text{山}$$\\text{感}$$\\text{到}$$\\text{莫}$$\\text{名}$$\\text{其}$$\\text{妙}$$\\text{。}$",
