            "b": 0.0,
            "a": 0.8313726,
            "grayscale": 0.0,
            "maxColorComponent": 0.0
          }
        },
        {
          "Content": "$\\text{「}$$\\text{不}$$\\text{对}$$\\text{，}$$\\text{我}$$\\text{想}$$\\text{说}$$\\text{的}$$\\text{不}$$\\text{是}$$\\text{这}$$\\text{个}$$\\text{！}$$\\text{」}$",
          "TextType": "TexDraw",
          "Skip": false,
          "SpeakerName": "象山",
