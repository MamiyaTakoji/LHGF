            "grayscale": 0.0,
            "maxColorComponent": 0.0
          }
        },
        {
          "Content": "$\\text{「}$$\\text{一}$$\\text{个}$$\\text{名}$$\\text{叫}$$\\text{里}$$\\text{岛}$$\\text{一}$$\\text{年}$$\\text{的}$$\\text{病}$$\\text{患}$$\\text{，}$$\\text{正}$$\\text{面}$$\\text{临}$——$\\text{」}$",
          "TextType": "TexDraw",
          "Skip": false,
          "SpeakerName": "象山",
          "DepartmentName": "",
          "DialogBarColor": {
            "r": 0.0,
            "g": 0.0,
            "b": 0.0,
            "a": 0.8313726,
            "grayscale": 0.0,
            "maxColorComponent": 0.0
          }
        },
        {
          "Content": "$\\text{「}$$\\text{房}$$\\text{屋}$$\\text{将}$$\\text{要}$$\\text{坍}$$\\text{塌}$$\\text{的}$$\\text{危}$$\\text{险}$$\\text{处}$$\\text{境}$$\\text{，}$$\\text{他}$$\\text{的}$$\\text{房}$$\\text{屋}$$\\text{快}$$\\text{要}$$\\text{倒}$$\\text{塌}$$\\text{了}$$\\text{！}$$\\text{」}$",
          "TextType": "TexDraw",
          "Skip": false,
          "SpeakerName": "象山",
          "DepartmentName": "",
          "DialogBarColor": {
            "r": 0.0,
            "g": 0.0,
