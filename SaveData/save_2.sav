            "maxColorComponent": 0.0
          }
        },
        {
          "Content": "$\\text{「}$$\\text{过}$$\\text{奖}$$\\text{了}$$\\text{。}$$\\text{跟}$$\\text{您}$$\\text{相}$$\\text{比}$$\\text{我}$$\\text{差}$$\\text{太}$$\\text{远}$$\\text{了}$$\\text{。}$$\\text{」}$",
