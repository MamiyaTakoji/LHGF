        },
        {
          "Content": "$\\text{据}$$\\text{说}$$\\text{土}$$\\text{野}$$\\text{撬}$$\\text{起}$$\\text{榻}$$\\text{榻}$$\\text{米}$$\\text{以}$$\\text{及}$$\\text{木}$$\\text{地}$$\\text{板}$$\\text{钻}$$\\text{进}$$\\text{地}$$\\text{板}$$\\text{下}$$\\text{方}$$\\text{，}$$\\text{并}$$\\text{往}$$\\text{地}$$\\text{底}$$\\text{下}$$\\text{挖}$$\\text{洞}$$\\text{，}$$\\text{挖}$$\\text{出}$$\\text{一}$$\\text{个}$$\\text{约}$$\\text{七}$$\\text{十}$$\\text{公}$$\\text{分}$$\\text{高}$$\\text{的}$$\\text{空}$$\\text{间}$$\\text{。}$$\\text{土}$$\\text{野}$$\\text{在}$$\\text{地}$$\\text{面}$$\\text{铺}$$\\text{了}$$\\text{帆}$$\\text{布}$$\\text{，}$$\\text{毛}$$\\text{毯}$$\\text{、}$$\\text{酒}$$\\text{瓶}$$\\text{、}$$\\text{宝}$$\\text{特}$$\\text{瓶}$$\\text{、}$$\\text{零}$$\\text{食}$$\\text{包}$$\\text{装}$$\\text{、}$$\\text{烟}$$\\text{蒂}$$\\text{、}$$\\text{囤}$$\\text{积}$$\\text{粪}$$\\text{便}$$\\text{尿}$$\\text{液}$$\\text{的}$$\\text{塑}$$\\text{胶}$$\\text{购}$$\\text{物}$$\\text{袋}$$\\text{，}$$\\text{以}$$\\text{及}$$\\text{蜈}$$\\text{蚣}$$\\text{、}$$\\text{蟑}$$\\text{螂}$$\\text{残}$$\\text{骸}$$\\text{胡}$$\\text{乱}$$\\text{散}$$\\text{落}$$\\text{在}$$\\text{帆}$$\\text{布}$$\\text{上}$$\\text{。}$",
