            "a": 0.8313726,
            "grayscale": 0.0,
            "maxColorComponent": 0.0
          }
        },
        {
          "Content": "$\\text{『}$$\\text{房}$$\\text{屋}$$\\text{坍}$$\\text{塌}$$\\text{？}$$\\text{那}$$\\text{和}$$\\text{我}$$\\text{有}$$\\text{什}$$\\text{么}$$\\text{关}$$\\text{系}$$\\text{？}$$\\text{』}$",
          "TextType": "TexDraw",
