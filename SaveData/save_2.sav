            "a": 0.8313726,
            "grayscale": 0.0,
            "maxColorComponent": 0.0
          }
        },
        {
          "Content": "$\\text{「}$$\\text{一}$$\\text{个}$$\\text{名}$$\\text{叫}$$\\text{里}$$\\text{岛}$$\\text{一}$$\\text{年}$$\\text{的}$$\\text{病}$$\\text{患}$$\\text{，}$$\\text{正}$$\\text{面}$$\\text{临}$——$\\text{」}$",
          "TextType": "TexDraw",
          "Skip": false,
          "SpeakerName": "象山",
          "DepartmentName": "",
          "DialogBarColor": {
            "r": 0.0,
            "g": 0.0,
            "b": 0.0,
            "a": 0.8313726,
            "grayscale": 0.0,
            "maxColorComponent": 0.0
          }
        },
        {
          "Content": "$\\text{「}$$\\text{受}$$\\text{恶}$$\\text{魔}$$\\text{伤}$$\\text{害}$$\\text{的}$$\\text{危}$$\\text{险}$$\\text{处}$$\\text{境}$$\\text{，}$$\\text{恶}$$\\text{魔}$$\\text{想}$$\\text{要}$$\\text{杀}$$\\text{死}$$\\text{他}$$\\text{！}$$\\text{」}$",
          "TextType": "TexDraw",
          "Skip": false,
          "SpeakerName": "象山",
          "DepartmentName": "",
          "DialogBarColor": {
            "r": 0.0,
            "g": 0.0,
            "b": 0.0,
            "a": 0.8313726,
            "grayscale": 0.0,
            "maxColorComponent": 0.0
          }
        },
        {
          "Content": "$\\text{『}$$\\text{医}$$\\text{生}$$\\text{，}$$\\text{你}$$\\text{终}$$\\text{于}$$\\text{还}$$\\text{是}$$\\text{疯}$$\\text{了}$$\\text{吗}$$\\text{？}$$\\text{』}$",
          "TextType": "TexDraw",
          "Skip": false,
          "SpeakerName": "芋洼",
          "DepartmentName": "",
          "DialogBarColor": {
            "r": 0.0,
            "g": 0.0,
            "b": 0.0,
            "a": 0.8313726,
            "grayscale": 0.0,
            "maxColorComponent": 0.0
          }
        },
        {
          "Content": "$\\text{「}$$\\text{不}$$\\text{对}$$\\text{，}$$\\text{我}$$\\text{想}$$\\text{说}$$\\text{的}$$\\text{不}$$\\text{是}$$\\text{这}$$\\text{个}$$\\text{！}$$\\text{」}$",
          "TextType": "TexDraw",
          "Skip": false,
          "SpeakerName": "象山",
          "DepartmentName": "",
          "DialogBarColor": {
            "r": 0.0,
            "g": 0.0,
