            "maxColorComponent": 0.0
          }
        },
        {
          "Content": "$\\text{「}$$\\text{昨}$$\\text{天}$ayakayaka$\\text{透}$$\\text{明}$$\\text{侦}$$\\text{探}$$\\text{简}$$\\text{直}$$\\text{就}$$\\text{是}$$\\text{神}$$\\text{反}$$\\text{击}$$\\text{！}$$\\text{」}$",
