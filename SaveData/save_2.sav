            "grayscale": 0.0,
            "maxColorComponent": 0.0
          }
        },
        {
          "Content": "$\\text{女}$$\\text{孩}$$\\text{的}$$\\text{表}$$\\text{情}$$\\text{显}$$\\text{得}$$\\text{更}$$\\text{加}$$\\text{僵}$$\\text{硬}$$\\text{。}$$\\text{文}$$\\text{哉}$$\\text{很}$$\\text{想}$$\\text{拿}$$\\text{出}$$\\text{自}$$\\text{己}$$\\text{的}$$\\text{手}$$\\text{机}$$\\text{给}$$\\text{女}$$\\text{孩}$$\\text{看}$$\\text{，}$$\\text{但}$$\\text{无}$$\\text{奈}$$\\text{豆}$$\\text{皮}$$\\text{乌}$$\\text{龙}$$\\text{面}$$\\text{和}$$\\text{豆}$$\\text{腐}$$\\text{汉}$$\\text{堡}$$\\text{排}$$\\text{定}$$\\text{食}$$\\text{让}$$\\text{文}$$\\text{哉}$$\\text{空}$$\\text{不}$$\\text{出}$$\\text{手}$$\\text{来}$$\\text{。}$",
