            "maxColorComponent": 0.0
          }
        },
        {
          "Content": "$\\text{文}$$\\text{哉}$$\\text{说}$$\\text{得}$$\\text{好}$$\\text{不}$$\\text{激}$$\\text{动}$$\\text{，}$$\\text{急}$$\\text{忙}$$\\text{用}$$\\text{掌}$$\\text{心}$$\\text{擦}$$\\text{拭}$$\\text{飞}$$\\text{散}$$\\text{到}$$\\text{桌}$$\\text{上}$$\\text{的}$$\\text{唾}$$\\text{液}$$\\text{。}$$\\text{多}$$\\text{亏}$$\\text{种}$$\\text{植}$$\\text{在}$$\\text{桌}$$\\text{子}$$\\text{旁}$$\\text{的}$$\\text{龙}$$\\text{血}$$\\text{树}$$\\text{叶}$$\\text{长}$$\\text{得}$$\\text{特}$$\\text{别}$$\\text{茂}$$\\text{密}$$\\text{，}$$\\text{让}$$\\text{文}$$\\text{哉}$$\\text{即}$$\\text{使}$$\\text{上}$$\\text{班}$$\\text{时}$$\\text{间}$$\\text{在}$$\\text{这}$$\\text{里}$$\\text{摸}$$\\text{鱼}$$\\text{与}$$\\text{客}$$\\text{人}$$\\text{说}$$\\text{话}$$\\text{，}$$\\text{也}$$\\text{不}$$\\text{会}$$\\text{被}$$\\text{厨}$$\\text{房}$$\\text{里}$$\\text{的}$$\\text{员}$$\\text{工}$$\\text{看}$$\\text{见}$$\\text{。}$",
