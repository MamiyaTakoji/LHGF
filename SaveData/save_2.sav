            "maxColorComponent": 0.0
          }
        },
        {
          "Content": "$\\text{象}$$\\text{山}$$\\text{看}$$\\text{着}$$\\text{地}$$\\text{震}$$\\text{速}$$\\text{报}$$\\text{的}$ＡＰＰ$\\text{画}$$\\text{面}$$\\text{确}$$\\text{认}$$\\text{内}$$\\text{容}$$\\text{。}$$\\text{象}$$\\text{山}$$\\text{自}$$\\text{家}$$\\text{所}$$\\text{在}$$\\text{的}$$\\text{大}$$\\text{食}$$\\text{地}$$\\text{区}$$\\text{也}$$\\text{是}$$\\text{震}$$\\text{度}$$\\text{二}$$\\text{。}$",
          "TextType": "TexDraw",
          "Skip": false,
