            "b": 0.0,
            "a": 0.8313726,
            "grayscale": 0.0,
            "maxColorComponent": 0.0
          }
        },
        {
          "Content": "$\\text{『}$$\\text{哟}$$\\text{！}$$\\text{非}$$\\text{洲}$$\\text{象}$$\\text{医}$$\\text{生}$$\\text{，}$$\\text{难}$$\\text{得}$$\\text{你}$$\\text{会}$$\\text{主}$$\\text{动}$$\\text{打}$$\\text{电}$$\\text{话}$$\\text{给}$$\\text{我}$$\\text{。}$$\\text{』}$",
          "TextType": "TexDraw",
          "Skip": false,
          "SpeakerName": "芋洼",
          "DepartmentName": "",
          "DialogBarColor": {
            "r": 0.0,
            "g": 0.0,
            "b": 0.0,
            "a": 0.8313726,
            "grayscale": 0.0,
            "maxColorComponent": 0.0
          }
        },
        {
          "Content": "$\\text{芋}$$\\text{洼}$$\\text{似}$$\\text{乎}$$\\text{没}$$\\text{有}$$\\text{很}$$\\text{忙}$$\\text{碌}$$\\text{的}$$\\text{样}$$\\text{子}$$\\text{。}$",
          "TextType": "TexDraw",
          "Skip": false,
          "SpeakerName": " ",
          "DepartmentName": "",
          "DialogBarColor": {
            "r": 0.0,
            "g": 0.0,
            "b": 0.0,
            "a": 0.8313726,
            "grayscale": 0.0,
            "maxColorComponent": 0.0
          }
        },
        {
          "Content": "$\\text{「}$$\\text{请}$$\\text{你}$$\\text{到}$$\\text{我}$$\\text{接}$$\\text{下}$$\\text{来}$$\\text{会}$$\\text{说}$$\\text{的}$$\\text{公}$$\\text{寓}$$\\text{进}$$\\text{行}$$\\text{搜}$$\\text{索}$$\\text{。}$$\\text{这}$$\\text{是}$$\\text{紧}$$\\text{急}$$\\text{事}$$\\text{态}$$\\text{。}$$\\text{地}$$\\text{址}$$\\text{是}$$\\text{神}$$\\text{之}$$\\text{精}$$\\text{市}$$\\text{空}$$\\text{躁}$──$\\text{」}$",
          "TextType": "TexDraw",
          "Skip": false,
          "SpeakerName": "象山",
          "DepartmentName": "",
          "DialogBarColor": {
            "r": 0.0,
            "g": 0.0,
            "b": 0.0,
            "a": 0.8313726,
            "grayscale": 0.0,
            "maxColorComponent": 0.0
          }
        },
        {
          "Content": "$\\text{『}$$\\text{医}$$\\text{生}$$\\text{，}$$\\text{我}$$\\text{已}$$\\text{经}$$\\text{说}$$\\text{过}$$\\text{很}$$\\text{多}$$\\text{遍}$$\\text{了}$$\\text{。}$$\\text{』}$",
          "TextType": "TexDraw",
          "Skip": false,
          "SpeakerName": "芋洼",
          "DepartmentName": "",
          "DialogBarColor": {
            "r": 0.0,
            "g": 0.0,
            "b": 0.0,
            "a": 0.8313726,
            "grayscale": 0.0,
            "maxColorComponent": 0.0
          }
        },
        {
          "Content": "$\\text{打}$$\\text{火}$$\\text{机}$$\\text{点}$$\\text{火}$$\\text{的}$$\\text{声}$$\\text{响}$$\\text{传}$$\\text{来}$$\\text{。}$",
          "TextType": "TexDraw",
          "Skip": false,
          "SpeakerName": " ",
          "DepartmentName": "",
          "DialogBarColor": {
            "r": 0.0,
            "g": 0.0,
            "b": 0.0,
            "a": 0.8313726,
            "grayscale": 0.0,
            "maxColorComponent": 0.0
          }
        },
        {
          "Content": "$\\text{『}$$\\text{现}$$\\text{在}$$\\text{不}$$\\text{是}$$\\text{昭}$$\\text{和}$$\\text{时}$$\\text{代}$$\\text{。}$$\\text{我}$$\\text{不}$$\\text{可}$$\\text{能}$$\\text{没}$$\\text{有}$$\\text{搜}$$\\text{索}$$\\text{令}$$\\text{就}$$\\text{乱}$$\\text{扣}$$\\text{押}$$\\text{人}$$\\text{。}$$\\text{』}$",
          "TextType": "TexDraw",
          "Skip": false,
          "SpeakerName": "芋洼",
          "DepartmentName": "",
          "DialogBarColor": {
