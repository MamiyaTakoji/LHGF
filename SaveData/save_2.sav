        },
        {
          "Content": "$\\text{一}$$\\text{名}$$\\text{自}$$\\text{称}$$\\text{名}$$\\text{为}$$\\text{土}$$\\text{野}$$\\text{毅}$$\\text{的}$$\\text{男}$$\\text{子}$$\\text{，}$$\\text{在}$$\\text{象}$$\\text{山}$$\\text{的}$$\\text{病}$$\\text{患}$$\\text{里}$$\\text{岛}$$\\text{一}$$\\text{年}$$\\text{所}$$\\text{居}$$\\text{住}$$\\text{的}$$\\text{东}$$\\text{荣}$$\\text{庄}$$\\text{公}$$\\text{寓}$$\\text{，}$$\\text{因}$$\\text{侵}$$\\text{入}$$\\text{住}$$\\text{居}$$\\text{之}$$\\text{嫌}$$\\text{疑}$$\\text{而}$$\\text{被}$$\\text{视}$$\\text{为}$$\\text{现}$$\\text{行}$$\\text{犯}$$\\text{遭}$$\\text{到}$$\\text{逮}$$\\text{捕}$$\\text{。}$",
