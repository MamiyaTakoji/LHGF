        },
        {
          "Content": "$\\text{『}$$\\text{有}$$\\text{人}$$\\text{躲}$$\\text{在}$$\\text{里}$$\\text{岛}$$\\text{先}$$\\text{生}$$\\text{的}$$\\text{房}$$\\text{间}$$\\text{里}$$\\text{？}$$\\text{你}$$\\text{是}$$\\text{怎}$$\\text{么}$$\\text{知}$$\\text{道}$$\\text{的}$$\\text{？}$$\\text{』}$",
