          }
        },
        {
          "Content": "$\\text{「}$$\\text{地}$$\\text{震}$$\\text{是}$$\\text{在}$$\\text{早}$$\\text{上}$$\\text{七}$$\\text{点}$$\\text{三}$$\\text{十}$$\\text{二}$$\\text{分}$$\\text{，}$$\\text{也}$$\\text{就}$$\\text{是}$$\\text{我}$$\\text{早}$$\\text{已}$$\\text{身}$$\\text{在}$$\\text{客}$$\\text{厅}$$\\text{的}$$\\text{时}$$\\text{刻}$$\\text{发}$$\\text{生}$$\\text{。}$$\\text{但}$$\\text{是}$$\\text{我}$$\\text{却}$$\\text{没}$$\\text{有}$$\\text{意}$$\\text{识}$$\\text{到}$$\\text{，}$$\\text{这}$$\\text{是}$$\\text{因}$$\\text{为}$——$\\text{」}$",
