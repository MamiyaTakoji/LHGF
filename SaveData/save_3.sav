        },
        {
          "Content": "$\\text{文}$$\\text{哉}$$\\text{冲}$$\\text{进}$$\\text{电}$$\\text{梯}$$\\text{里}$$\\text{。}$$\\text{抵}$$\\text{达}$$\\text{一}$$\\text{楼}$$\\text{后}$$\\text{，}$$\\text{文}$$\\text{哉}$$\\text{寻}$$\\text{找}$$\\text{着}$$\\text{员}$$\\text{工}$$\\text{出}$$\\text{入}$$\\text{口}$$\\text{，}$$\\text{最}$$\\text{后}$$\\text{无}$$\\text{视}$$\\text{于}$$\\text{警}$$\\text{卫}$$\\text{的}$$\\text{警}$$\\text{告}$$\\text{声}$$\\text{，}$$\\text{直}$$\\text{接}$$\\text{解}$$\\text{开}$$\\text{门}$$\\text{锁}$$\\text{，}$$\\text{朝}$$\\text{向}$$\\text{停}$$\\text{车}$$\\text{场}$$\\text{冲}$$\\text{出}$$\\text{去}$$\\text{。}$",
