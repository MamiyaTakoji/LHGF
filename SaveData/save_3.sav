            "grayscale": 0.0,
            "maxColorComponent": 0.0
          }
        },
        {
          "Content": "$\\text{舞}$$\\text{冬}$$\\text{左}$$\\text{手}$$\\text{拿}$$\\text{着}$$\\text{保}$$\\text{健}$$\\text{品}$$\\text{的}$$\\text{瓶}$$\\text{子}$$\\text{把}$$\\text{玩}$$\\text{时}$$\\text{，}$$\\text{喉}$$\\text{咙}$$\\text{发}$$\\text{出}$$\\text{吞}$$\\text{咽}$$\\text{声}$$\\text{。}$$\\text{每}$$\\text{次}$$\\text{精}$$\\text{神}$$\\text{紧}$$\\text{张}$$\\text{时}$$\\text{，}$$\\text{舞}$$\\text{冬}$$\\text{就}$$\\text{会}$$\\text{出}$$\\text{现}$$\\text{消}$$\\text{化}$$\\text{物}$$\\text{逆}$$\\text{流}$$\\text{到}$$\\text{喉}$$\\text{咙}$$\\text{的}$$\\text{现}$$\\text{象}$$\\text{。}$",
          "TextType": "TexDraw",
