        },
        {
          "Content": "$\\text{象}$$\\text{山}$$\\text{指}$$\\text{着}$$\\text{芋}$$\\text{洼}$$\\text{的}$$\\text{头}$$\\text{部}$$\\text{说}$$\\text{：}$",
          "TextType": "TexDraw",
