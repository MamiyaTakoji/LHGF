            "a": 0.8313726,
            "grayscale": 0.0,
            "maxColorComponent": 0.0
          }
        },
        {
          "Content": "$\\text{「}$$\\text{我}$$\\text{刚}$$\\text{刚}$$\\text{说}$$\\text{的}$$\\text{事}$$\\text{情}$$\\text{。}$$\\text{」}$",
          "TextType": "TexDraw",
