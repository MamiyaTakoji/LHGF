            "grayscale": 0.0,
            "maxColorComponent": 0.0
          }
        },
        {
          "Content": "$\\text{芋}$$\\text{洼}$$\\text{似}$$\\text{乎}$$\\text{没}$$\\text{有}$$\\text{很}$$\\text{忙}$$\\text{碌}$$\\text{的}$$\\text{样}$$\\text{子}$$\\text{。}$",
