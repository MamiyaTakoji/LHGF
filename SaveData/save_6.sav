            "maxColorComponent": 0.0
          }
        },
        {
          "Content": "$\\text{「}$$\\text{而}$$\\text{参}$$\\text{加}$$\\text{『}$$\\text{哈}$$\\text{啰}$$\\text{！}$$\\text{活}$$\\text{力}$$\\text{东}$$\\text{北}$$\\text{！}$$\\text{』}$$\\text{的}$$\\text{录}$$\\text{影}$$\\text{。}$$\\text{在}$$\\text{舞}$$\\text{冬}$$\\text{跳}$$\\text{起}$$\\text{来}$$\\text{后}$$\\text{，}$$\\text{也}$$\\text{就}$$\\text{是}$$\\text{地}$$\\text{震}$$\\text{平}$$\\text{息}$$\\text{后}$$\\text{的}$$\\text{下}$$\\text{一}$$\\text{刻}$$\\text{，}$$\\text{鲨}$$\\text{田}$$\\text{安}$$\\text{保}$$\\text{两}$$\\text{人}$$\\text{有}$$\\text{过}$$\\text{这}$$\\text{么}$$\\text{一}$$\\text{段}$$\\text{胡}$$\\text{闹}$$\\text{互}$$\\text{动}$$\\text{。}$$\\text{」}$",
          "TextType": "TexDraw",
