        [
          {
            "Continue": false,
            "Content": "\\noindent {\\bf\\color{yellow}  $\\text{彩}$$\\text{夏}$$\\text{死}$$\\text{亡}$$\\text{时}$$\\text{的}$$\\text{状}$$\\text{况}$}     \\begin{tabular}{| l | x |}     \\hline     $\\text{幸}$$\\text{运}$$\\text{者}$&  \\text{$\\text{象}$$\\text{山}$$\\text{与}$$\\text{彩}$$\\text{夏}$$\\text{看}$$\\text{完}$$\\text{演}$$\\text{唱}$$\\text{会}$$\\text{的}$$\\text{归}$$\\text{途}$$\\text{上}$$\\text{，}$$\\text{一}$$\\text{起}$$\\text{走}$$\\text{在}$$\\text{自}$$\\text{然}$$\\text{公}$$\\text{园}$$\\text{里}$$\\text{。}$$\\text{彩}$$\\text{夏}$$\\text{在}$$\\text{小}$$\\text{路}$$\\text{上}$$\\text{踏}$$\\text{出}$$\\text{步}$$\\text{伐}$$\\text{时}$$\\text{爆}$$\\text{炸}$$\\text{。}$} \\\\ \\hline    $\\text{修}$$\\text{复}$$\\text{者}$ &  \\text{$\\text{象}$$\\text{山}$$\\text{在}$$\\text{医}$$\\text{院}$$\\text{的}$$\\text{走}$$\\text{廊}$$\\text{上}$$\\text{看}$$\\text{着}$$\\text{彩}$$\\text{夏}$$\\text{。}$$\\text{彩}$$\\text{夏}$$\\text{来}$$\\text{医}$$\\text{院}$$\\text{内}$$\\text{的}$$\\text{食}$$\\text{堂}$$\\text{休}$$\\text{息}$$\\text{室}$$\\text{拿}$$\\text{东}$$\\text{西}$$\\text{的}$$\\text{归}$$\\text{途}$$\\text{中}$$\\text{，}$$\\text{走}$$\\text{在}$$\\text{人}$$\\text{行}$$\\text{道}$$\\text{时}$$\\text{爆}$$\\text{炸}$$\\text{。}$}\\\\ \\hline     $\\text{逃}$$\\text{亡}$$\\text{者}$& \\text{ $\\text{象}$$\\text{山}$$\\text{在}$$\\text{东}$$\\text{荣}$$\\text{庄}$$\\text{看}$$\\text{直}$$\\text{播}$$\\text{。}$$\\text{彩}$$\\text{夏}$$\\text{在}$$\\text{酱}$$\\text{窠}$$\\text{的}$$\\text{公}$$\\text{寓}$$\\text{大}$$\\text{楼}$$\\text{房}$$\\text{间}$$\\text{里}$$\\text{进}$$\\text{行}$$\\text{直}$$\\text{播}$$\\text{到}$$\\text{一}$$\\text{半}$$\\text{时}$$\\text{爆}$$\\text{炸}$$\\text{。}$} \\\\ \\hline      $\\text{垂}$$\\text{死}$$\\text{者}$&  \\text{$\\text{象}$$\\text{山}$$\\text{身}$$\\text{负}$$\\text{重}$$\\text{伤}$$\\text{住}$$\\text{院}$$\\text{中}$$\\text{。}$$\\text{彩}$$\\text{夏}$$\\text{状}$$\\text{况}$$\\text{不}$$\\text{明}$$\\text{。}$}  \\\\ \\hline     \\end{tabular}",
