            "grayscale": 0.0,
            "maxColorComponent": 0.0
          }
        },
        {
          "Content": "$\\text{「}$$\\text{请}$$\\text{你}$$\\text{到}$$\\text{我}$$\\text{接}$$\\text{下}$$\\text{来}$$\\text{会}$$\\text{说}$$\\text{的}$$\\text{公}$$\\text{寓}$$\\text{进}$$\\text{行}$$\\text{搜}$$\\text{索}$$\\text{。}$$\\text{这}$$\\text{是}$$\\text{紧}$$\\text{急}$$\\text{事}$$\\text{态}$$\\text{。}$$\\text{地}$$\\text{址}$$\\text{是}$$\\text{神}$$\\text{之}$$\\text{精}$$\\text{市}$$\\text{空}$$\\text{躁}$──$\\text{」}$",
          "TextType": "TexDraw",
          "Skip": false,
          "SpeakerName": "象山",
          "DepartmentName": "",
          "DialogBarColor": {
