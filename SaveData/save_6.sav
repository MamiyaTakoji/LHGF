            "maxColorComponent": 0.0
          }
        },
        {
          "Content": "$\\text{『}$$\\text{不}$$\\text{用}$$\\text{，}$$\\text{请}$$\\text{以}$$\\text{妳}$$\\text{的}$$\\text{行}$$\\text{程}$$\\text{为}$$\\text{优}$$\\text{先}$$\\text{。}$$\\text{』}$",
