            "maxColorComponent": 0.0
          }
        },
        {
          "Content": "$\\text{「}$$\\text{与}$$\\text{此}$$\\text{同}$$\\text{时}$$\\text{，}$$\\text{在}$$\\text{里}$$\\text{岛}$$\\text{的}$$\\text{公}$$\\text{寓}$——$\\text{」}$",
          "TextType": "TexDraw",
