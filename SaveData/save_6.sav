            "maxColorComponent": 0.0
          }
        },
        {
          "Content": "$\\text{「}$$\\text{今}$$\\text{天}$$\\text{早}$$\\text{上}$$\\text{鲨}$$\\text{田}$$\\text{安}$$\\text{保}$$\\text{与}$$\\text{卡}$$\\text{卡}$$\\text{粕}$$\\text{谷}$$\\text{为}$$\\text{了}$$\\text{宣}$$\\text{传}$$\\text{今}$$\\text{晚}$$\\text{即}$$\\text{将}$$\\text{播}$$\\text{出}$$\\text{的}$$\\text{节}$$\\text{目}$$\\text{『}$$\\text{科}$$\\text{学}$$\\text{侦}$$\\text{探}$$\\text{特}$$\\text{别}$$\\text{篇}$ $\\text{时}$$\\text{间}$$\\text{是}$$\\text{什}$$\\text{么}$$\\text{？}$$\\text{』}$$\\text{」}$",
          "TextType": "TexDraw",
