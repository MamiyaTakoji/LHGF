            "maxColorComponent": 0.0
          }
        },
        {
          "Content": "$\\text{象}$$\\text{山}$$\\text{自}$$\\text{顾}$$\\text{自}$$\\text{地}$$\\text{继}$$\\text{续}$$\\text{说}$$\\text{：}$",
          "TextType": "TexDraw",
