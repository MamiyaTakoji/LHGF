        },
        {
          "Content": "$\\text{女}$$\\text{子}$$\\text{的}$$\\text{发}$$\\text{言}$$\\text{不}$$\\text{太}$$\\text{对}$$\\text{劲}$$\\text{。}$",
          "TextType": "TexDraw",
