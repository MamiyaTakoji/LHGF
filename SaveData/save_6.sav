          }
        },
        {
          "Content": "$\\text{「}$$\\text{是}$$\\text{啊}$$\\text{，}$$\\text{有}$$\\text{什}$$\\text{么}$$\\text{事}$$\\text{吗}$$\\text{？}$$\\text{」}$",
          "TextType": "TexDraw",
