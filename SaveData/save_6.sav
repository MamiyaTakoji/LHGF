            "maxColorComponent": 0.0
          }
        },
        {
          "Content": "$\\text{象}$$\\text{山}$$\\text{陷}$$\\text{入}$$\\text{一}$$\\text{种}$$\\text{仿}$$\\text{佛}$$\\text{脚}$$\\text{下}$$\\text{的}$$\\text{地}$$\\text{板}$$\\text{崩}$$\\text{塌}$$\\text{的}$$\\text{感}$$\\text{觉}$$\\text{。}$$\\text{那}$$\\text{感}$$\\text{觉}$$\\text{就}$$\\text{像}$$\\text{忽}$$\\text{然}$$\\text{发}$$\\text{现}$$\\text{本}$$\\text{以}$$\\text{为}$$\\text{像}$$\\text{空}$$\\text{气}$$\\text{一}$$\\text{样}$$\\text{理}$$\\text{所}$$\\text{当}$$\\text{然}$$\\text{存}$$\\text{在}$$\\text{的}$$\\text{东}$$\\text{西}$$\\text{，}$$\\text{实}$$\\text{际}$$\\text{上}$$\\text{是}$$\\text{截}$$\\text{然}$$\\text{不}$$\\text{同}$$\\text{的}$$\\text{东}$$\\text{西}$$\\text{。}$",
