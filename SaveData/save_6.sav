            "maxColorComponent": 0.0
          }
        },
        {
          "Content": "$\\text{象}$$\\text{山}$$\\text{走}$$\\text{进}$$\\text{食}$$\\text{堂}$$\\text{的}$$\\text{空}$$\\text{间}$$\\text{，}$$\\text{寻}$$\\text{找}$$\\text{着}$$\\text{声}$$\\text{音}$$\\text{的}$$\\text{主}$$\\text{人}$$\\text{。}$$\\text{有}$$\\text{张}$$\\text{桌}$$\\text{子}$$\\text{被}$$\\text{夹}$$\\text{在}$$\\text{龙}$$\\text{血}$$\\text{树}$$\\text{盆}$$\\text{栽}$$\\text{以}$$\\text{及}$$\\text{墙}$$\\text{壁}$$\\text{之}$$\\text{间}$$\\text{，}$$\\text{三}$$\\text{人}$$\\text{组}$$\\text{在}$$\\text{那}$$\\text{张}$$\\text{桌}$$\\text{子}$$\\text{前}$$\\text{有}$$\\text{说}$$\\text{有}$$\\text{笑}$$\\text{。}$$\\text{象}$$\\text{山}$$\\text{让}$$\\text{目}$$\\text{光}$$\\text{停}$$\\text{留}$$\\text{在}$$\\text{三}$$\\text{人}$$\\text{组}$$\\text{身}$$\\text{上}$$\\text{，}$$\\text{朝}$$\\text{向}$$\\text{那}$$\\text{张}$$\\text{桌}$$\\text{子}$$\\text{走}$$\\text{近}$$\\text{。}$",
