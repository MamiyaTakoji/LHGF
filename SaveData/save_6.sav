            "maxColorComponent": 0.0
          }
        },
        {
          "Content": "$\\text{三}$$\\text{名}$$\\text{喝}$$\\text{着}$$\\text{焙}$$\\text{茶}$$\\text{的}$$\\text{女}$$\\text{子}$$\\text{动}$$\\text{作}$$\\text{一}$$\\text{致}$$\\text{地}$$\\text{擡}$$\\text{起}$$\\text{头}$$\\text{看}$$\\text{。}$",
