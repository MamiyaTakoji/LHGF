          "Content": "$\\text{没}$$\\text{救}$$\\text{了}$$\\text{，}$$\\text{季}$$\\text{季}$$\\text{已}$$\\text{保}$$\\text{不}$$\\text{住}$$\\text{性}$$\\text{命}$$\\text{。}$$\\text{不}$$\\text{用}$$\\text{说}$$\\text{也}$$\\text{知}$$\\text{道}$$\\text{，}$$\\text{人}$$\\text{类}$$\\text{一}$$\\text{般}$$\\text{不}$$\\text{可}$$\\text{能}$$\\text{吐}$$\\text{出}$$\\text{内}$$\\text{脏}$$\\text{。}$$\\text{肯}$$\\text{定}$$\\text{是}$$\\text{其}$$\\text{他}$$\\text{时}$$\\text{空}$$\\text{的}$$\\text{某}$$\\text{人}$$\\text{把}$$\\text{季}$$\\text{季}$$\\text{的}$$\\text{内}$$\\text{脏}$$\\text{扯}$$\\text{了}$$\\text{出}$$\\text{来}$$\\text{。}$$\\text{意}$$\\text{思}$$\\text{就}$$\\text{是}$$\\text{，}$$\\text{象}$$\\text{山}$$\\text{担}$$\\text{心}$$\\text{的}$$\\text{事}$$\\text{情}$$\\text{真}$$\\text{的}$$\\text{发}$$\\text{生}$$\\text{了}$$\\text{。}$",
          "TextType": "TexDraw",
          "Skip": false,
          "SpeakerName": " ",
          "DepartmentName": "",
          "DialogBarColor": {
            "r": 0.0,
            "g": 0.0,
            "b": 0.0,
            "a": 0.8313726,
            "grayscale": 0.0,
            "maxColorComponent": 0.0
          }
        },
        {
          "Content": "$\\text{「}$$\\text{请}$$\\text{问}$$\\text{这}$$\\text{是}$$\\text{什}$$\\text{么}$$\\text{状}$$\\text{况}$$\\text{？}$$\\text{」}$",
          "TextType": "TexDraw",
          "Skip": false,
          "SpeakerName": "乙田",
          "DepartmentName": "",
          "DialogBarColor": {
            "r": 0.0,
            "g": 0.0,
            "b": 0.0,
            "a": 0.8313726,
            "grayscale": 0.0,
            "maxColorComponent": 0.0
          }
        },
        {
          "Content": "$\\text{男}$$\\text{子}$$\\text{任}$$\\text{凭}$$\\text{鲜}$$\\text{血}$$\\text{从}$$\\text{双}$$\\text{手}$$\\text{滴}$$\\text{落}$$\\text{问}$$\\text{道}$$\\text{。}$$\\text{自}$$\\text{然}$$\\text{公}$$\\text{园}$$\\text{的}$$\\text{出}$$\\text{口}$$\\text{方}$$\\text{向}$$\\text{传}$$\\text{来}$$\\text{男}$$\\text{女}$$\\text{的}$$\\text{窃}$$\\text{窃}$$\\text{私}$$\\text{语}$$\\text{声}$$\\text{。}$$\\text{他}$$\\text{们}$$\\text{想}$$\\text{必}$$\\text{已}$$\\text{经}$$\\text{发}$$\\text{现}$$\\text{有}$$\\text{人}$$\\text{倒}$$\\text{在}$$\\text{地}$$\\text{上}$$\\text{。}$",
          "TextType": "TexDraw",
          "Skip": false,
          "SpeakerName": " ",
          "DepartmentName": "",
          "DialogBarColor": {
            "r": 0.0,
            "g": 0.0,
            "b": 0.0,
            "a": 0.8313726,
            "grayscale": 0.0,
            "maxColorComponent": 0.0
          }
        },
        {
          "Content": "$\\text{「}$$\\text{我}$$\\text{记}$$\\text{得}$$\\text{象}$$\\text{山}$$\\text{先}$$\\text{生}$$\\text{是}$$\\text{医}$$\\text{生}$$\\text{，}$$\\text{对}$$\\text{吧}$$\\text{？}$$\\text{请}$$\\text{问}$$\\text{究}$$\\text{竟}$$\\text{要}$$\\text{怎}$$\\text{么}$$\\text{做}$$\\text{才}$$\\text{会}$$\\text{变}$$\\text{成}$$\\text{这}$$\\text{样}$$\\text{？}$$\\text{」}$",
          "TextType": "TexDraw",
          "Skip": false,
          "SpeakerName": "乙田",
          "DepartmentName": "",
          "DialogBarColor": {
            "r": 0.0,
            "g": 0.0,
            "b": 0.0,
            "a": 0.8313726,
            "grayscale": 0.0,
            "maxColorComponent": 0.0
          }
        },
        {
          "Content": "$\\text{象}$$\\text{山}$$\\text{不}$$\\text{知}$$\\text{道}$$\\text{该}$$\\text{怎}$$\\text{么}$$\\text{做}$$\\text{才}$$\\text{好}$$\\text{？}$$\\text{先}$$\\text{杀}$$\\text{了}$$\\text{男}$$\\text{子}$$\\text{再}$$\\text{说}$$\\text{？}$$\\text{可}$$\\text{是}$$\\text{，}$$\\text{现}$$\\text{在}$$\\text{有}$$\\text{其}$$\\text{他}$$\\text{人}$$\\text{看}$$\\text{着}$$\\text{，}$$\\text{总}$$\\text{不}$$\\text{能}$$\\text{光}$$\\text{明}$$\\text{正}$$\\text{大}$$\\text{地}$$\\text{杀}$$\\text{人}$$\\text{。}$",
          "TextType": "TexDraw",
          "Skip": false,
          "SpeakerName": " ",
          "DepartmentName": "",
          "DialogBarColor": {
            "r": 0.0,
            "g": 0.0,
            "b": 0.0,
            "a": 0.8313726,
            "grayscale": 0.0,
            "maxColorComponent": 0.0
          }
        },
        {
          "Content": "$\\text{「}$──$\\text{可}$$\\text{恶}$$\\text{！}$$\\text{」}$",
          "TextType": "TexDraw",
          "Skip": false,
          "SpeakerName": "象山",
          "DepartmentName": "",
          "DialogBarColor": {
            "r": 0.0,
            "g": 0.0,
            "b": 0.0,
            "a": 0.8313726,
            "grayscale": 0.0,
            "maxColorComponent": 0.0
          }
        },
        {
          "Content": "$\\text{象}$$\\text{山}$$\\text{转}$$\\text{过}$$\\text{身}$$\\text{子}$$\\text{，}$$\\text{朝}$$\\text{向}$$\\text{十}$$\\text{字}$$\\text{路}$$\\text{口}$$\\text{冲}$$\\text{去}$$\\text{。}$",
          "TextType": "TexDraw",
          "Skip": false,
          "SpeakerName": " ",
