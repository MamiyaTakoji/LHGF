            "maxColorComponent": 0.0
          }
        },
        {
          "Content": "$\\text{『}$$\\text{妳}$$\\text{四}$$\\text{月}$$\\text{四}$$\\text{号}$$\\text{的}$$\\text{下}$$\\text{午}$$\\text{有}$$\\text{空}$$\\text{吗}$$\\text{？}$$\\text{那}$$\\text{天}$$\\text{是}$$\\text{巡}$$\\text{演}$$\\text{最}$$\\text{终}$$\\text{场}$$\\text{的}$$\\text{隔}$$\\text{天}$$\\text{，}$$\\text{新}$$\\text{生}$Cocaine Babies$\\text{来}$$\\text{邀}$$\\text{约}$AKADAMA$\\text{参}$$\\text{加}$$\\text{他}$$\\text{们}$$\\text{自}$$\\text{费}$$\\text{举}$$\\text{办}$$\\text{的}$$\\text{活}$$\\text{动}$$\\text{。}$$\\text{如}$$\\text{果}$$\\text{接}$$\\text{受}$$\\text{邀}$$\\text{约}$$\\text{，}$$\\text{会}$$\\text{是}$$\\text{要}$$\\text{负}$$\\text{责}$$\\text{开}$$\\text{场}$$\\text{表}$$\\text{演}$$\\text{。}$$\\text{』}$",
          "TextType": "TexDraw",
          "Skip": false,
          "SpeakerName": "姆伊",
