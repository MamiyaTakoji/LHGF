            "grayscale": 0.0,
            "maxColorComponent": 0.0
          }
        },
        {
          "Content": "$\\text{『}$$\\text{是}$$\\text{喔}$$\\text{～}$$\\text{那}$$\\text{天}$$\\text{我}$$\\text{是}$$\\text{已}$$\\text{经}$$\\text{安}$$\\text{排}$$\\text{了}$$\\text{行}$$\\text{程}$$\\text{，}$$\\text{要}$$\\text{不}$$\\text{要}$$\\text{我}$$\\text{挪}$$\\text{开}$$\\text{行}$$\\text{程}$$\\text{？}$$\\text{』}$",
