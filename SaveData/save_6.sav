            "grayscale": 0.0,
            "maxColorComponent": 0.0
          }
        },
        {
          "Content": "$\\text{「}$$\\text{你}$$\\text{看}$$\\text{，}$$\\text{早}$$\\text{上}$$\\text{七}$$\\text{点}$$\\text{三}$$\\text{十}$$\\text{二}$$\\text{分}$$\\text{。}$$\\text{神}$$\\text{之}$$\\text{精}$$\\text{市}$$\\text{各}$$\\text{区}$$\\text{几}$$\\text{乎}$$\\text{都}$$\\text{是}$$\\text{震}$$\\text{度}$$\\text{二}$$\\text{。}$$\\text{」}$",
