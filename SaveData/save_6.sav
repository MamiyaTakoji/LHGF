        },
        {
          "Content": "$\\text{「}$$\\text{里}$$\\text{岛}$$\\text{发}$$\\text{现}$$\\text{地}$$\\text{板}$$\\text{突}$$\\text{然}$$\\text{像}$$\\text{有}$$\\text{人}$$\\text{走}$$\\text{过}$$\\text{去}$$\\text{一}$$\\text{样}$$\\text{晃}$$\\text{了}$$\\text{一}$$\\text{下}$$\\text{，}$$\\text{回}$$\\text{过}$$\\text{头}$$\\text{看}$$\\text{去}$$\\text{时}$$\\text{听}$$\\text{见}$$\\text{榻}$$\\text{榻}$$\\text{米}$$\\text{嘎}$$\\text{吱}$$\\text{叫}$$\\text{了}$$\\text{一}$$\\text{声}$$\\text{」}$",
          "TextType": "TexDraw",
