            "grayscale": 0.0,
            "maxColorComponent": 0.0
          }
        },
        {
          "Content": "$\\text{「}$$\\text{今}$$\\text{天}$$\\text{早}$$\\text{上}$$\\text{神}$$\\text{之}$$\\text{精}$$\\text{市}$$\\text{发}$$\\text{生}$$\\text{过}$$\\text{地}$$\\text{震}$$\\text{吗}$$\\text{？}$$\\text{」}$",
