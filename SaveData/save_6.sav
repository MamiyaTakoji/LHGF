          }
        },
        {
          "Content": "$\\text{『}$$\\text{现}$$\\text{在}$$\\text{不}$$\\text{是}$$\\text{昭}$$\\text{和}$$\\text{时}$$\\text{代}$$\\text{。}$$\\text{我}$$\\text{不}$$\\text{可}$$\\text{能}$$\\text{没}$$\\text{有}$$\\text{搜}$$\\text{索}$$\\text{令}$$\\text{就}$$\\text{乱}$$\\text{扣}$$\\text{押}$$\\text{人}$$\\text{。}$$\\text{』}$",
