          }
        },
        {
          "Content": "$\\text{打}$$\\text{火}$$\\text{机}$$\\text{点}$$\\text{火}$$\\text{的}$$\\text{声}$$\\text{响}$$\\text{传}$$\\text{来}$$\\text{。}$",
