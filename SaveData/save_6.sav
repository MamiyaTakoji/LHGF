            "grayscale": 0.0,
            "maxColorComponent": 0.0
          }
        },
        {
          "Content": "$\\text{『}$$\\text{哟}$$\\text{！}$$\\text{非}$$\\text{洲}$$\\text{象}$$\\text{医}$$\\text{生}$$\\text{，}$$\\text{难}$$\\text{得}$$\\text{你}$$\\text{会}$$\\text{主}$$\\text{动}$$\\text{打}$$\\text{电}$$\\text{话}$$\\text{给}$$\\text{我}$$\\text{。}$$\\text{』}$",
