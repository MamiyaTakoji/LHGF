            "grayscale": 0.0,
            "maxColorComponent": 0.0
          }
        },
        {
          "Content": "$\\text{女}$$\\text{子}$$\\text{有}$$\\text{所}$$\\text{误}$$\\text{解}$$\\text{吗}$$\\text{？}$$\\text{不}$$\\text{，}$$\\text{万}$$\\text{一}$$\\text{事}$$\\text{实}$$\\text{真}$$\\text{是}$$\\text{如}$$\\text{此}$──",
