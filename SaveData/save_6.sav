            "maxColorComponent": 0.0
          }
        },
        {
          "Content": "$\\text{「}$$\\text{房}$$\\text{屋}$$\\text{将}$$\\text{要}$$\\text{坍}$$\\text{塌}$$\\text{的}$$\\text{危}$$\\text{险}$$\\text{处}$$\\text{境}$$\\text{，}$$\\text{他}$$\\text{的}$$\\text{房}$$\\text{屋}$$\\text{快}$$\\text{要}$$\\text{倒}$$\\text{塌}$$\\text{了}$$\\text{！}$$\\text{」}$",
