            "grayscale": 0.0,
            "maxColorComponent": 0.0
          }
        },
        {
          "Content": "$\\text{象}$$\\text{山}$$\\text{在}$$\\text{通}$$\\text{道}$$\\text{上}$$\\text{边}$$\\text{走}$$\\text{边}$$\\text{启}$$\\text{动}$$\\text{平}$$\\text{板}$$\\text{电}$$\\text{脑}$$\\text{后}$$\\text{，}$$\\text{连}$$\\text{结}$$\\text{到}$$\\text{病}$$\\text{患}$$\\text{资}$$\\text{料}$$\\text{库}$$\\text{确}$$\\text{认}$$\\text{里}$$\\text{岛}$$\\text{一}$$\\text{年}$$\\text{的}$$\\text{地}$$\\text{址}$$\\text{。}$$\\text{接}$$\\text{着}$$\\text{，}$$\\text{象}$$\\text{山}$$\\text{拿}$$\\text{出}$$\\text{手}$$\\text{机}$$\\text{，}$$\\text{拨}$$\\text{打}$$\\text{电}$$\\text{话}$$\\text{给}$$\\text{神}$$\\text{之}$$\\text{精}$$\\text{警}$$\\text{署}$$\\text{的}$$\\text{芋}$$\\text{洼}$$\\text{。}$",
