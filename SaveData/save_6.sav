            "grayscale": 0.0,
            "maxColorComponent": 0.0
          }
        },
        {
          "Content": "──$\\text{你}$$\\text{是}$$\\text{谁}$$\\text{？}$──$\\text{我}$$\\text{是}$$\\text{爱}$$\\text{因}$$\\text{斯}$$\\text{坦}$$\\text{。}$",
